''' <summary>
''' Specifies the alignment of a separator line within its control bounds.
''' </summary>
Public Enum SeparatorAlignment
    ''' <summary>
    ''' Aligns the separator near the top or left edge.
    ''' </summary>
    Near
    ''' <summary>
    ''' Aligns the separator at the center.
    ''' </summary>
    Center
    ''' <summary>
    ''' Aligns the separator near the bottom or right edge.
    ''' </summary>
    Far
End Enum