<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>CoreSuite.Services.Cryptography</RootNamespace>
		<TargetFramework>net8.0</TargetFramework>
		<AssemblyName>CoreSuite.Cryptography</AssemblyName>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>CoreSuite.Cryptography</PackageId>
		<Version>1.0.0</Version>
		<Authors>Leandro Galdino</Authors>
		<Company>CoreSuite</Company>
		<Title>CoreSuite Cryptography</Title>
		<Description>Secure .NET 8 utilities for SHA-256 hashing, PBKDF2 password hashing and AES-256-GCM authenticated encryption.</Description>
		<PackageTags>coresuite;cryptography;security;sha256;hashing;password;pbkdf2;aes;gcm;encryption;vbnet;dotnet;net8</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/leandrogaldino/CoreSuite/tree/main/Cryptography</PackageProjectUrl>
		<RepositoryUrl>https://github.com/leandrogaldino/CoreSuite</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Initial release with SHA-256 hashing, versioned PBKDF2-HMAC-SHA256 password hashes and password-based AES-256-GCM authenticated encryption.</PackageReleaseNotes>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageOutputPath>..\artifacts\packages</PackageOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
