<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>CoreSuite.Services</RootNamespace>
		<TargetFramework>net8.0</TargetFramework>
		<AssemblyName>CoreSuite.FileMerger</AssemblyName>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>CoreSuite.FileMerger</PackageId>
		<Version>1.0.0</Version>
		<Authors>Leandro Galdino</Authors>
		<Company>CoreSuite</Company>
		<Title>CoreSuite FileMerger</Title>
		<Description>Creates and restores password-encrypted container files from one or more directory trees, with metadata and progress reporting.</Description>
		<PackageTags>coresuite;files;merge;container;backup;aes;encryption;metadata;progress;vbnet;dotnet;net8</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/leandrogaldino/CoreSuite/tree/main/FileMerger</PackageProjectUrl>
		<RepositoryUrl>https://github.com/leandrogaldino/CoreSuite</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Initial release with synchronous and asynchronous directory merging, extraction, metadata inspection and password-based AES encryption.</PackageReleaseNotes>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageOutputPath>..\artifacts\packages</PackageOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
