<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>CoreSuite.Controls</RootNamespace>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyName>CoreSuite.$(MSBuildProjectName)</AssemblyName>
		<PackageId>CoreSuite.PasswordBox</PackageId>
		<Version>2.0.0</Version>
		<Authors>Leandro Galdino</Authors>
		<Company>CoreSuite</Company>
		<Title>CoreSuite PasswordBox</Title>
		<Description>Reusable WinForms password TextBox with secure replacement workflow, visibility toggle, defined-password placeholder and embedded customizable action button.</Description>
		<PackageTags>coresuite;winforms;password;textbox;credentials;security;vbnet;dotnet</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Refactored PasswordBox to inherit directly from TextBox, providing native text editing behavior while preserving the embedded customizable image action button, password-defined state, replacement workflow, show/hide functionality, fixed-length stored-password placeholder, change tracking, cancellation, acceptance flow, accessibility support and complete XML documentation. Removed the previous UserControl-based layout and custom border properties.</PackageReleaseNotes>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/LeandroGaldino/CoreSuite</RepositoryUrl>
		<PackageProjectUrl>https://github.com/LeandroGaldino/CoreSuite</PackageProjectUrl>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
	<ItemGroup>
		<Compile Update="Resources\Images.Designer.vb">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Images.resx</DependentUpon>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="Resources\Images.resx">
			<CustomToolNamespace>My.Resources</CustomToolNamespace>
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Images.Designer.vb</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
