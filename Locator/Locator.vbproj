<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>CoreSuite.Infrastructure</RootNamespace>
		<TargetFramework>net8.0</TargetFramework>
		<AssemblyName>CoreSuite.Locator</AssemblyName>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>CoreSuite.Locator</PackageId>
		<Version>2.0.0</Version>
		<Authors>Leandro Galdino</Authors>
		<Company>CoreSuite</Company>
		<Title>CoreSuite Locator</Title>
		<Description>Lightweight .NET 8 service locator with singleton, factory and keyed registrations.</Description>
		<PackageTags>coresuite;locator;service-locator;dependency-injection;ioc;singleton;factory;vbnet;dotnet;net8</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/leandrogaldino/CoreSuite/tree/main/Locator</PackageProjectUrl>
		<RepositoryUrl>https://github.com/leandrogaldino/CoreSuite</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Corrected the root namespace from CoreSuite.Infraestructure to CoreSuite.Infrastructure.</PackageReleaseNotes>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageOutputPath>..\artifacts\packages\</PackageOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>