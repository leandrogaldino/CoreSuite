''' <summary>
''' Specifies the SQL database dialect used when generating SQL statements.
''' </summary>
Public Enum SqlDialect

    ''' <summary>
    ''' Represents the MySQL database dialect.
    ''' </summary>
    MySql

    ''' <summary>
    ''' Represents the Microsoft SQL Server database dialect.
    ''' </summary>
    SqlServer

    ''' <summary>
    ''' Represents the PostgreSQL database dialect.
    ''' </summary>
    PostgreSql

    ''' <summary>
    ''' Represents the SQLite database dialect.
    ''' </summary>
    Sqlite

    ''' <summary>
    ''' Represents the Oracle Database SQL dialect.
    ''' </summary>
    Oracle

    ''' <summary>
    ''' Represents the Firebird database dialect.
    ''' </summary>
    Firebird

End Enum