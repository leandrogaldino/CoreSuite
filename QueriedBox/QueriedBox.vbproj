<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>CoreSuite.Controls</RootNamespace>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyName>CoreSuite.QueriedBox</AssemblyName>
		<PackageId>CoreSuite.QueriedBox</PackageId>
		<Version>1.0.1</Version>
		<PackageReleaseNotes>Corrected XML documentation for query conditions, joins, and column configuration APIs.</PackageReleaseNotes>
		<Authors>Leandro Galdino</Authors>
		<Company>CoreSuite</Company>
		<Title>CoreSuite QueriedBox</Title>
		<Description>A database-backed lookup and selection control for .NET 8 Windows Forms, with configurable SQL queries, popup results and primary-key selection.</Description>
		<PackageTags>coresuite;winforms;queriedbox;lookup;autocomplete;database;vbnet;dotnet</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/leandrogaldino/CoreSuite/tree/main/QueriedBox</PackageProjectUrl>
		<RepositoryUrl>https://github.com/leandrogaldino/CoreSuite</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<IsPackable>true</IsPackable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>
	<ItemGroup>
		<Import Include="System.Data" />
		<Import Include="System.Drawing" />
		<Import Include="System.Windows.Forms" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.WinForms.Designer.SDK" Version="1.6.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Helpers\Helpers.vbproj" />
	</ItemGroup>
	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>