<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>CoreSuite.Controls</RootNamespace>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyName>CoreSuite.$(MSBuildProjectName)</AssemblyName>
		<PackageId>CoreSuite.CMessageBox</PackageId>
		<Version>1.1.0</Version>
		<PackageReleaseNotes>Added ExceptionReporter integration and a localizable footer message for the exception details popup through CMessageBoxOptions.FooterMessageExceptionDetailsPopup.</PackageReleaseNotes>
		<Authors>Leandro Galdino</Authors>
		<Company>CoreSuite</Company>
		<Title>CoreSuite CMessageBox</Title>
		<Description>A customizable Windows Forms message box with multiple message types, exception details and optional exception reporting by email.</Description>
		<PackageTags>coresuite;winforms;messagebox;dialog;exception;email;mailkit;vbnet;dotnet;net8</PackageTags>		
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>		
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/leandrogaldino/CoreSuite</PackageProjectUrl>
		<RepositoryUrl>https://github.com/leandrogaldino/CoreSuite</RepositoryUrl>		
		<RepositoryType>git</RepositoryType>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>		
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageOutputPath>..\artifacts\packages</PackageOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<Import Include="System.Data" />
		<Import Include="System.Drawing" />
		<Import Include="System.Windows.Forms" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ControlContainer\ControlContainer.vbproj" />
		<ProjectReference Include="..\ExceptionReporter\ExceptionReporter.vbproj" />
		<ProjectReference Include="..\NoFocusCueButton\NoFocusCueButton.vbproj" />
	</ItemGroup>
	<ItemGroup>
		<Compile Update="Resources\ImageResources.Designer.vb">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>ImageResources.resx</DependentUpon>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="Resources\ImageResources.resx">
			<CustomToolNamespace>My.Resources</CustomToolNamespace>
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>ImageResources.Designer.vb</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<Service Include="{94e38dff-614b-4cbd-b67c-f211bb35ce8b}" />
	</ItemGroup>
</Project>
