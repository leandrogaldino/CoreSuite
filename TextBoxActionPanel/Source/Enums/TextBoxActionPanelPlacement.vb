''' <summary>
''' Specifies where a <see cref="TextBoxActionPanel"/> is positioned relative to its target text box.
''' </summary>
Public Enum TextBoxActionPanelPlacement
    ''' <summary>
    ''' Places the panel above the target when space is available and below it otherwise.
    ''' </summary>
    Auto
    ''' <summary>
    ''' Places the panel above the target control.
    ''' </summary>
    Above
    ''' <summary>
    ''' Places the panel below the target control.
    ''' </summary>
    Below
End Enum
