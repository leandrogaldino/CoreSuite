<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>CoreSuite.Controls</RootNamespace>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyName>CoreSuite.$(MSBuildProjectName)</AssemblyName>
		<PackageId>CoreSuite.DateTimeBox</PackageId>
		<Version>1.0.2</Version>
		<Authors>Leandro Galdino</Authors>
		<Company>CoreSuite</Company>
		<Title>CoreSuite DateTimeBox</Title>
		<Description>Culture-aware WinForms date and time input control with masked entry, a combined calendar and time dropdown, and designer support.</Description>
		<PackageTags>coresuite;winforms;datetime;date;time;maskedtextbox;control;vbnet;dotnet</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/leandrogaldino/CoreSuite</PackageProjectUrl>
		<RepositoryUrl>https://github.com/leandrogaldino/CoreSuite</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Updated the CoreSuite.ControlContainer dependency to version 1.0.2 to include the latest important fixes.</PackageReleaseNotes>
		<IsPackable>true</IsPackable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageOutputPath>..\artifacts\packages</PackageOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<Import Include="System.Data" />
		<Import Include="System.Drawing" />
		<Import Include="System.Windows.Forms" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.WinForms.Designer.SDK" Version="1.6.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ControlContainer\ControlContainer.vbproj" />
		<ProjectReference Include="..\DateTimeBoxBase\DateTimeBoxBase.vbproj" />
	</ItemGroup>
	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
	  <Service Include="{94e38dff-614b-4cbd-b67c-f211bb35ce8b}" />
	</ItemGroup>
</Project>
