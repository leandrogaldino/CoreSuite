<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>CoreSuite.Controls</RootNamespace>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyName>CoreSuite.$(MSBuildProjectName)</AssemblyName>
		<PackageId>CoreSuite.PictureViewer</PackageId>
		<Version>1.0.0</Version>
		<PackageReleaseNotes>Initial release of the PictureViewer control.</PackageReleaseNotes>
		<Authors>Leandro Galdino</Authors>
		<Company>CoreSuite</Company>
		<Title>CoreSuite PictureViewer</Title>
		<Description>A Windows Forms image viewer with navigation, inclusion, removal and save commands plus customizable tooltips.</Description>
		<PackageTags>coresuite;winforms;image;picture;viewer;navigation;vbnet;dotnet;net8</PackageTags>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/leandrogaldino/CoreSuite</PackageProjectUrl>
		<RepositoryUrl>https://github.com/leandrogaldino/CoreSuite</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageOutputPath>..\artifacts\packages</PackageOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<Import Include="System.Data" />
		<Import Include="System.Drawing" />
		<Import Include="System.Windows.Forms" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\NoFocusCueButton\NoFocusCueButton.vbproj" />
	</ItemGroup>
	<ItemGroup>
		<Compile Update="Resources\Images.Designer.vb">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Images.resx</DependentUpon>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="Resources\Images.resx">
			<CustomToolNamespace>My.Resources</CustomToolNamespace>
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Images.Designer.vb</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
</Project>

